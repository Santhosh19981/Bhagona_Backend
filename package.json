{
  "name": "bhagona-backend",
  "version": "1.2.0",
  "description": "Bhagona backend v3 - Express + MySQL (stored procedures wired)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node -r dotenv/config src/index.js dotenv_config_path=.env.production",
    "start:qa": "node -r dotenv/config src/index.js dotenv_config_path=.env.qa",
    "dev": "nodemon src/index.js",
    "dev:qa": "node -r dotenv/config ./node_modules/nodemon/bin/nodemon.js src/index.js dotenv_config_path=.env.qa",
    "clone:db": "node clone_db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.3.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
